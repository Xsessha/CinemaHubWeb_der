                <TablixRow>
                  <Height>0.72cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="GroupLabel"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!GroupLabel.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>=IIF(Fields!GroupLevel.Value = 0, "10pt", "9pt")</FontSize><FontWeight>=IIF(Fields!GroupLevel.Value = 0 OR Fields!GroupLevel.Value = 1 OR Fields!GroupLevel.Value = 3, "Bold", "Normal")</FontWeight><Color>=IIF(Fields!GroupLevel.Value = 2, "#475569", "#1F3A5F")</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>GroupLabel</rd:DefaultName><Style><Border><Color>#D5DDE8</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>=Switch(Fields!GroupLevel.Value = 0, "#E4EDF8", Fields!GroupLevel.Value = 1, "#F1F5F9", Fields!GroupLevel.Value = 2, "#FFFFFF", True, "#DCE6F5")</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>6pt</PaddingLeft><PaddingRight>4pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="TicketCount"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!TicketCount.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Format>N0</Format><Color>#334155</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>TicketCount</rd:DefaultName><Style><Border><Color>#D5DDE8</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>=Switch(Fields!GroupLevel.Value = 0, "#E4EDF8", Fields!GroupLevel.Value = 1, "#F1F5F9", Fields!GroupLevel.Value = 2, "#FFFFFF", True, "#DCE6F5")</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>5pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GrossAmount"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!GrossAmount.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Format>N2</Format><Color>#334155</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>GrossAmount</rd:DefaultName><Style><Border><Color>#D5DDE8</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>=Switch(Fields!GroupLevel.Value = 0, "#E4EDF8", Fields!GroupLevel.Value = 1, "#F1F5F9", Fields!GroupLevel.Value = 2, "#FFFFFF", True, "#DCE6F5")</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>5pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="PaidAmount"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!PaidAmount.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Format>N2</Format><Color>=Switch(Fields!PaidPercent.Value &gt;= 80, "#2E7D32", Fields!PaidPercent.Value &gt;= 50, "#B7791F", True, "#C62828")</Color><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>PaidAmount</rd:DefaultName><Style><Border><Color>#D5DDE8</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>=Switch(Fields!GroupLevel.Value = 0, "#E4EDF8", Fields!GroupLevel.Value = 1, "#F1F5F9", Fields!GroupLevel.Value = 2, "#FFFFFF", True, "#DCE6F5")</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>5pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="PaidPercent"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!PaidPercent.Value</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Format>N1</Format><Color>=Switch(Fields!PaidPercent.Value &gt;= 80, "#2E7D32", Fields!PaidPercent.Value &gt;= 50, "#B7791F", True, "#C62828")</Color><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>PaidPercent</rd:DefaultName><Style><Border><Color>#D5DDE8</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>=Switch(Fields!GroupLevel.Value = 0, "#E4EDF8", Fields!GroupLevel.Value = 1, "#F1F5F9", Fields!GroupLevel.Value = 2, "#FFFFFF", True, "#DCE6F5")</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>5pt</PaddingRight></Style></Textbox></CellContents></TablixCell>

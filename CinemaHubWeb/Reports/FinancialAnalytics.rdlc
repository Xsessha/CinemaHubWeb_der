              <TablixRows>
                <TablixRow>
                  <Height>0.85cm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="HeaderLabel"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Жанр / фільм / дата</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>HeaderLabel</rd:DefaultName><Style><Border><Color>#FFFFFF</Color><Style>Solid</Style></Border><BackgroundColor>#1F3A5F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>6pt</PaddingLeft><PaddingRight>4pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HeaderCount"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Квитків</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>HeaderCount</rd:DefaultName><Style><Border><Color>#FFFFFF</Color><Style>Solid</Style></Border><BackgroundColor>#1F3A5F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>5pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HeaderGross"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Нараховано, грн</Value><Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>HeaderGross</rd:DefaultName><Style><Border><Color>#FFFFFF</Color><Style>Solid</Style></Border><BackgroundColor>#1F3A5F</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft><PaddingRight>5pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
